@test("epsilon-NFA to DFA conversion")
@given("file")
#initial q0;
#final q2, q3;

q0 -> q1 by '1';
q1 -> q2 by '2';
q2 -> q3 by '7';
q0 -> q2 by @@epsilon;

@whenRun("./bin/fsmconv")
@expectOutput("stdout")
#initial s0;
#final s0, s1, s3;

s0 to s2 by '1';
s0 to s1 by '7';
s2 to s3 by '2';
s3 to s1 by '7';

@endtest
