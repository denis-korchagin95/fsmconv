@test("epsilon-NFA to NFA dot: simple epsilon on single edge")
@given("file")
#initial q0;
#final q2, q3;

q0 -> q1 by '1';
q1 -> q2 by '2';
q2 -> q3 by '7';
q0 -> q2 by @@epsilon;

@whenRun("./bin/fsmconv", args="--to-nfa --format=dot")
@expectOutput("stdout")
digraph nfa {
	s0 [label="State 'q0'", shape=tripleoctagon];
	s0 -> s2 [label="7"];
	s0 -> s3 [label="1"];
	s3 [label="State 'q1'"]; 
	s3 -> s1 [label="2"];
	s1 [label="State 'q2'", shape=doubleoctagon];
	s1 -> s2 [label="7"];
	s2 [label="State 'q3'", shape=doubleoctagon];
}

@endtest

@test("epsilon-NFA to NFA dot: aa*|bb* pattern")
@given("file")
#initial q0;
#final q2, q4;

q0 -> q1 by @@epsilon;
q0 -> q3 by @@epsilon;
q1 -> q2 by 'a';
q2 -> q2 by 'a';
q3 -> q4 by 'b';
q4 -> q4 by 'b';

@whenRun("./bin/fsmconv", args="--to-nfa --format=dot")
@expectOutput("stdout")
digraph nfa {
	s0 [label="State 'q0'", shape=invhouse];
	s0 -> s2 [label="b"];
	s0 -> s1 [label="a"];
	s3 [label="State 'q1'"]; 
	s3 -> s1 [label="a"];
	s4 [label="State 'q3'"]; 
	s4 -> s2 [label="b"];
	s1 [label="State 'q2'", shape=doubleoctagon];
	s1 -> s1 [label="a"];
	s2 [label="State 'q4'", shape=doubleoctagon];
	s2 -> s2 [label="b"];
}

@endtest

@test("epsilon-NFA to NFA dot: chained epsilons")
@given("file")
#initial q0;
#final q3;

q0 -> q1 by @@epsilon;
q1 -> q2 by @@epsilon;
q2 -> q3 by 'a';

@whenRun("./bin/fsmconv", args="--to-nfa --format=dot")
@expectOutput("stdout")
digraph nfa {
	s0 [label="State 'q0'", shape=invhouse];
	s0 -> s1 [label="a"];
	s2 [label="State 'q1'"]; 
	s2 -> s1 [label="a"];
	s3 [label="State 'q2'"]; 
	s3 -> s1 [label="a"];
	s1 [label="State 'q3'", shape=doubleoctagon];
}

@endtest
