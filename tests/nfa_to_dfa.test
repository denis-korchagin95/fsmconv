@test("simple epsilon-NFA to DFA conversion")
@given("file")
#initial A;
#final C;

A -> B by '0', @@epsilon;
A -> A by '0', '1';
B -> C by '1', @@epsilon;

@whenRun("./bin/fsmconv")
@expectOutput("stdout")
#initial s0;
#final s0;

s0 to s0 by '1';
s0 to s0 by '0';

@endtest

@test("NFA with multiple transitions to DFA")
@given("file")
#initial q0;
#final q2, q4;

q0 -> q1 by 'a';
q1 -> q2 by 'b', 'c';
q1 -> q3 by 'c';
q3 -> q4 by 'd';

@whenRun("./bin/fsmconv")
@expectOutput("stdout")
#initial s0;
#final s2, s3, s4;

s0 to s1 by 'a';
s1 to s3 by 'c';
s1 to s2 by 'b';
s3 to s4 by 'd';

@endtest

@test("epsilon-NFA for aa*|bb* to DFA")
@given("file")
#initial q0;
#final q2, q4;

q0 -> q1 by @@epsilon;
q0 -> q3 by @@epsilon;
q1 -> q2 by 'a';
q2 -> q2 by 'a';
q3 -> q4 by 'b';
q4 -> q4 by 'b';

@whenRun("./bin/fsmconv")
@expectOutput("stdout")
#initial s0;
#final s1, s2;

s0 to s2 by 'b';
s0 to s1 by 'a';
s1 to s1 by 'a';
s2 to s2 by 'b';

@endtest
