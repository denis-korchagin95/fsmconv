@test("unite multiple initial states into single state")
@given("file")
#initial q0, q2, q3;
#final q4;

q0 -> q1 by 'c';
q0 -> q2 by 'b';
q2 -> q1 by @@epsilon;
q1 -> q3 by 'a';
q3 -> q3 by 'a';
q3 -> q2 by @@epsilon;
q3 -> q4 by 'b';

@whenRun("./bin/fsmconv", args="--unite-initials")
@expectOutput("stdout")
#initial s0;
#final s2, s4;

s0 to s3 by 'c';
s0 to s2 by 'b';
s0 to s1 by 'a';
s1 to s4 by 'b';
s1 to s1 by 'a';
s2 to s1 by 'a';
s3 to s1 by 'a';

@endtest
